{
    "name": "Archlens",
    "rootFolder": "./src",
    "github": {
        "url": "https://github.com/archlens/ArchLens",
        "branch": "main"
    },
    "saveLocation": "./diagrams/",
    "runCommand": "go run ./ast_parsers/go/ast_parser.go",
    "views": {
        "completeView": {
            "include": [
                "**/*.*",
                "*.*"
            ],
            "exclude": [
                "go.sum",
                "go.mod"
            ]
        },
        "smallerView": {
            "include": [
                "cmd/*.*",
                "main.go"
            ],
            "exclude": []
        }
    }
}